# Copia este archivo como .env  (nunca lo subas al repositorio)
# No uses el signo $ en las contrasenas: Docker Compose lo interpreta como variable.

# --- Base de datos ---
MYSQL_ROOT_PASSWORD=CambiaEstaClaveRoot123
DB_NAME=avisena
DB_USER=avisena
DB_PASSWORD=CambiaEstaClave123
DB_HOST=db
DB_PORT=3306

# --- Sesiones ---
# JWT_SECRET: minimo 32 caracteres. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria-de-32-o-mas
MINUTOS_ACCESO=30
DIAS_REFRESCO=14
COOKIE_SEGURA=false

# --- Cache / limites de intentos ---
REDIS_URL=redis://cache:6379/0

# --- Usuario inicial de la plataforma ---
ADMIN_EMAIL=admin@avisena.com
ADMIN_PASSWORD=Admin12345
ADMIN_NOMBRE=Administrador AVISENA

# --- Cuenta y finca de ejemplo que se crean la primera vez ---
CUENTA_DEMO=Granja de ejemplo
FINCA_DEMO=Finca principal

# --- Correo (recuperacion de contrasena). Opcional en local ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_DESDE=

# --- Origenes permitidos para el navegador ---
CORS_ORIGENES=http://localhost:3000,http://127.0.0.1:3000

# --- Puertos en tu maquina ---
WEB_PUERTO_HOST=3000
API_PUERTO_HOST=8000
DB_PUERTO_HOST=3308
