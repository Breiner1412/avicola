# Avicola en tu equipo (docker-compose.local.yml).
# Copialo como .env.local (que no se sube a git) y cambia las claves: solo letras y numeros.

# --- General ---
# desarrollo: en local no hay HTTPS, y en produccion la API exige COOKIE_SEGURA=true
ENTORNO=desarrollo
DEMO=true
ZONA_HORARIA=America/Bogota
TZ=America/Bogota

# --- Base de datos (la demo va en su propia base) ---
MYSQL_ROOT_PASSWORD=CambiaEstaClaveRoot
DB_NAME=avicola_demo
DB_USER=avicola_app
DB_PASSWORD=CambiaEstaClaveApp
DB_MIGRA_USER=avicola
DB_MIGRA_PASSWORD=CambiaEstaClaveMigra

# --- Redis ---
REDIS_PASSWORD=CambiaEstaClaveRedis

# --- Sesiones ---
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria-de-32-o-mas
MINUTOS_ACCESO=30
DIAS_REFRESCO=14
# false: http://localhost:8080 no tiene HTTPS
COOKIE_SEGURA=false

# --- Usuario de plataforma (administra todas las cuentas) ---
ADMIN_EMAIL=admin@avicola.com
ADMIN_PASSWORD=CambiaEstaClaveAdmin
ADMIN_NOMBRE=Administrador

# --- Proxy ---
# La IP fija del Caddy de docker-compose.local.yml: la API solo le cree X-Forwarded-For a el
PROXY_CONFIABLE=172.31.250.10
CORS_ORIGENES=
